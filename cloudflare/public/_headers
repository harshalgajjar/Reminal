/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; frame-src 'self' blob:; manifest-src 'self'
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/voice/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cache-Control
  Content-Security-Policy: default-src 'none'; frame-ancestors 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'unsafe-inline'; connect-src 'self' blob:; worker-src 'self' blob:; img-src 'self' data:
  X-Frame-Options: SAMEORIGIN
  Cache-Control: no-cache
