{
  "manifest_version": 3,
  "name": "reminal",
  "description": "Lets agents in your reminal sessions on this computer use this browser. Switch it off from the reminal button.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "storage": { "managed_schema": "managed_schema.json" },
  "permissions": ["debugger", "scripting", "tabs", "tabGroups", "nativeMessaging", "storage", "notifications", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "reminal", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
